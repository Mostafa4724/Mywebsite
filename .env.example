# Copy this file to .env and fill it in, or start the server and use
# admin/settings.html to fill it in through the browser.
#
#   cp .env.example .env
#
# .env is gitignored. Never commit real values.

# --- Security keys ---
# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
# The two keys must be different from each other.
SECRET_KEY=
JWT_SECRET_KEY=
ACCESS_TOKEN_MINUTES=60
REFRESH_TOKEN_DAYS=30
MIN_PASSWORD_LENGTH=8

# --- Site addresses ---
FRONTEND_BASE_URL=http://127.0.0.1:5500
CORS_ORIGINS=http://127.0.0.1:5500,http://localhost:5500
PASSWORD_RESET_PATH=/page/reset-password.html

# --- Email (SMTP) ---
# Gmail needs a 16-character App Password, not the account password.
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USERNAME=
EMAIL_PASSWORD=
EMAIL_FROM=

# --- Registration & verification ---
REGISTRATION_VERIFICATION_MINUTES=10
REGISTRATION_MAX_PER_HOUR=5
REGISTRATION_RESEND_COOLDOWN_SECONDS=60
PASSWORD_RESET_MINUTES=30
PASSWORD_RESET_MAX_PER_HOUR=5

# --- Store identity (used in emails) ---
STORE_NAME=Your Shop
STORE_EMAIL=
STORE_PHONE=
STORE_WEBSITE=
STORE_LOGO_URL=

# --- Google sign-in (optional) ---
GOOGLE_CLIENT_ID=

# --- Bank transfer details shown at checkout ---
BANK_NAME=
BANK_ACCOUNT_NAME=
BANK_ACCOUNT_NUMBER=
BANK_ROUTING_NUMBER=

# --- SMS via Twilio (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# --- Handover defaults ---
# The credentials each copy of the shop is delivered with. The admin panel
# compares the live account against these to decide whether to show the
# "Please secure your account" warning. Change them here if you ship a
# different pair; the warning follows automatically.
DEFAULT_ADMIN_EMAIL=Admin@gmail.com
DEFAULT_ADMIN_PASSWORD=Admin@1234

# --- Server behaviour ---
# Set to 0 to disable the auto-reloader. The admin settings page needs it
# to restart the server cleanly after saving.
AUTO_RELOAD=1
